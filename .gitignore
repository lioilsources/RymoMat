# devconv:start
.env
.env.*
!.env.example
*.p8
*.p12
*.jks
key.properties
.DS_Store
.claude/settings.local.json
CLAUDE.local.md
.dart_tool/
build/
.flutter-plugins
.flutter-plugins-dependencies
lib/**/secrets.dart
bin/
*.test
*.out
# devconv:end

# repo-specific
!packages/*/bin/
work/
run/
# pubspec.lock with path dependencies is not committed
app/pubspec.lock
packages/rymo_editor/pubspec.lock
# generated by flutter gen-l10n (pub get)
app/lib/l10n/app_localizations*.dart
# bundled rhyme pack: run/rymo release cs, then copy (see README)
app/assets/packs/*.zip
